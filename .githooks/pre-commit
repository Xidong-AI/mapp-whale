#!/bin/sh
set -eu
cd "$(git rev-parse --show-toplevel)"

fail=0
staged=$(git diff --cached --name-only --diff-filter=ACMR)

check_path() {
  file=$1
  case "$file" in
    *.env|*.pem|*.key|*.p12|*.pfx|*id_rsa*|*id_ed25519*)
      echo "拒绝提交敏感文件：$file"
      fail=1
      ;;
  esac
  if [ -f "$file" ]; then
    size=$(wc -c < "$file")
    if [ "$size" -gt 5242880 ]; then
      echo "文件超过 5 MiB：$file"
      fail=1
    fi
  fi
}

if [ -n "$staged" ]; then
  while IFS= read -r file; do
    [ -n "$file" ] && check_path "$file"
  done <<EOF
$staged
EOF
fi

if command -v autocorrect >/dev/null 2>&1 && [ -n "$staged" ]; then
  files=$(printf '%s\n' "$staged" \
    | grep -E '\.(md|txt|json|jsonc|ya?ml)$' \
    | grep -v '^vendor/' || true)
  if [ -n "$files" ]; then
    if ! printf '%s\n' "$files" | xargs -r autocorrect --lint; then
      echo "autocorrect 排版检查未通过，运行 autocorrect --fix <file> 修复"
      fail=1
    fi
  fi
fi

exit "$fail"
